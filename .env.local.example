# --- База данных (PostgreSQL на том же сервере, отдельная БД/роль) ---
DATABASE_URL=postgres://tehnik_app:PASSWORD@127.0.0.1:5432/tehnik_db

# --- Адрес сайта (протокол определяет secure-куки админки) ---
NEXT_PUBLIC_APP_URL=http://localhost:3150

# --- Админка: один пароль владельца + секрет подписи сессии ---
# ADMIN_SESSION_SECRET — openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# --- Режим заказов: demo (заказ сохраняется как "ожидает подтверждения", оплата не проводится) | live ---
# Live пока недостижим — у магазина нет эквайринга. Не переключать без реального договора с банком/эквайером.
ORDERS_MODE=demo

# --- Порог "протухшего" импорта остатков (часов) — после него admin видит баннер ---
IMPORT_STALE_HOURS=72

# --- Почта для заявок (прокат/лиды), опционально ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# --- TODO: мессенджер-боты для заявок (ещё не подключены, см. docs/BOTS_TODO.md) ---
TELEGRAM_BOT_TOKEN=
VK_GROUP_TOKEN=
MAX_BOT_TOKEN=

# --- Юридическое ---
NEXT_PUBLIC_LEGAL_EMAIL=
